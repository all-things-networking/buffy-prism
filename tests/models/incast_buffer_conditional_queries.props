// Conditional-probability queries for incast_buffer_dtmc.pm
//
// Bad event Q : at least THRESH packets are dropped   ->  (drops>=THRESH)
// Condition A : a predicate over the INPUT (the senders' start slots),
//               summarised by "peak" = peak concurrency = the largest number
//               of senders ever transmitting in the same slot (equivalently,
//               the largest number of senders starting within any SLEN=3
//               consecutive slots), and by the start slots start1..start5.
//
// Queries come in groups of 3, exactly as in fqcodel_bl_5i_conditional_queries.props:
//     Query1 = P[Q]        (baseline, unconditional)
//     Query2 = P[Q & A]
//     Query3 = P[A]
//   and the conditional probability of the bad event is  P[Q|A] = Query2/Query3,
//   which you compare against the baseline Query1.
//
// Each run reaches the absorbing "done" state, where drops/peak hold their
// final values, so  P[ F (done & X) ]  is the probability that X holds at the
// end of the run.  (Reached within N + HORIZON = 16 steps; set the simulation
// max path length a little above that, e.g. 32.)

// ============================================================
// GROUP 1 -- A = "peak >= 4"   (MILD but highly informative)
//   peak>=4 happens with non-trivial probability, yet makes a drop almost
//   certain: the useful, non-obvious condition.
// ============================================================
P=? [ F ("done" & (drops>=1)) ]
P=? [ F ("done" & (drops>=1) & (peak>=4)) ]
P=? [ F ("done" & (peak>=4)) ]

// ============================================================
// GROUP 2 -- A = "peak >= 5"   (OBVIOUS / extreme: all senders synchronized)
//   Forces a drop, but is so rare that a counterexample drawn from it is not
//   representative of how the system behaves.
// ============================================================
P=? [ F ("done" & (drops>=1)) ]
P=? [ F ("done" & (drops>=1) & (peak>=5)) ]
P=? [ F ("done" & (peak>=5)) ]

// ============================================================
// GROUP 3 -- A = "peak >= 3"   (MILD but only weakly predictive)
//   Common (most runs reach concurrency 3) yet barely raises the drop
//   probability: shows that not every mild condition is informative.
// ============================================================
P=? [ F ("done" & (drops>=1)) ]
P=? [ F ("done" & (drops>=1) & (peak>=3)) ]
P=? [ F ("done" & (peak>=3)) ]

// ============================================================
// GROUP 4 -- A = "peak <= 2"   (SAFETY certificate)
//   Under this condition the bad event never happens: P[Q|A] = 0.
// ============================================================
P=? [ F ("done" & (drops>=1)) ]
P=? [ F ("done" & (drops>=1) & (peak<=2)) ]
P=? [ F ("done" & (peak<=2)) ]

// ============================================================
// GROUP 5 -- A = "spread <= 3"   (input phrased directly over start slots:
//   all five senders begin within a 3-slot window). Obvious / rare, like GROUP 2.
// ============================================================
P=? [ F ("done" & (drops>=1)) ]
P=? [ F ("done" & (drops>=1) & (max(start1,start2,start3,start4,start5)-min(start1,start2,start3,start4,start5)<=3)) ]
P=? [ F ("done" & (max(start1,start2,start3,start4,start5)-min(start1,start2,start3,start4,start5)<=3)) ]

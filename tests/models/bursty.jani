    },
    "states": {
     "op": "initial"
    }
   },
   "comment": "expected value of reward drops; step-bounded: Storm and modes (mcsta skips it)"
  },
  {
   "name": "e_backlog",
   "expression": {
    "op": "filter",
    "fun": "max",

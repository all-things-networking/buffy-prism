     "step-instant": 6
    },
    "states": {
     "op": "initial"
    }
   },
   "comment": "expected value of reward backlog; instantaneous: checked by Storm (modes v3.1.315 returns the initial value)"
  },
  {
   "name": "e_time",
   "expression": {
    "op": "filter",
    "fun": "max",
    "values": {
     "op": "Emax",
     "exp": "rew_steps",
     "accumulate": ["steps"],
